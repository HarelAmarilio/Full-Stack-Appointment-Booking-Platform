# MySQL connection string (e.g. from Aiven, PlanetScale, or a local instance)
DATABASE_URL=

# Google Calendar API OAuth2 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Admin dashboard login credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign admin JWT session tokens
JWT_SECRET=

# Optional: port for the Express server (defaults to 5001)
PORT=5001

# [Abuse protection] Number of proxies in front of the API (Render = 1). Rate limiting uses it to find the real client IP.
TRUST_PROXY_HOPS=1
